# PAN-OS / Panorama service account (dedicated, least-privilege, read-only per
# pan_api_research.md section 7)
PAN_USERNAME=
PAN_PASSWORD=

# Drata Custom Connection (required unless running with --collect-only)
# Connection/resource vars are PAN_-prefixed so this can share an Azure
# Function App with another Drata custom connection without colliding on
# App Settings names. DRATA_API_KEY is left unprefixed on the assumption
# it's one account-level key valid for any Custom Connection.
DRATA_API_KEY=
PAN_DRATA_CONNECTION_ID=
PAN_DRATA_RESOURCE_ID=
