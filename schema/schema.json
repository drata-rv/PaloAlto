{
  "title": "PAN-OS / Panorama Compliance Evidence",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "enum": [
        "pan_firewall",
        "panorama"
      ]
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "FIREWALL_LICENSE",
        "URL_FILTERING_PROFILE",
        "DNS_SECURITY_PROFILE",
        "SECURITY_RULE",
        "TRAFFIC_LOG_SUMMARY",
        "URL_FILTERING_LOG_SUMMARY",
        "DNS_THREAT_LOG_SUMMARY"
      ]
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLIANT",
        "NONCOMPLIANT",
        "CONFIGURED",
        "ENABLED",
        "DISABLED"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "deviceHostname": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "managedBy": {
      "type": "string",
      "enum": [
        "DIRECT",
        "PANORAMA"
      ]
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "serial": {
      "type": "string"
    },
    "issuedDate": {
      "type": "string"
    },
    "expiresDate": {
      "type": "string"
    },
    "authcode": {
      "type": "string"
    },
    "blockedCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alertCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dnsSecurityCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "logLevel": {
            "type": "string"
          }
        }
      }
    },
    "enabledCategoryCount": {
      "type": "integer"
    },
    "ruleScope": {
      "type": "string",
      "enum": [
        "LOCAL",
        "PRE_RULE",
        "POST_RULE"
      ]
    },
    "action": {
      "type": "string"
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceZones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destZones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "securityProfileGroup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "securityProfiles": {
      "type": "object"
    },
    "deviceGroup": {
      "type": "string"
    },
    "totalLogCount": {
      "type": "integer"
    },
    "affectedCount": {
      "type": "integer"
    },
    "windowStart": {
      "type": "string"
    },
    "windowEnd": {
      "type": "string"
    },
    "logLimitReached": {
      "type": "boolean"
    },
    "actionBreakdown": {
      "type": "object"
    },
    "categoryBreakdown": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "service",
    "evidenceType",
    "name",
    "status",
    "timestamp",
    "deviceHostname",
    "site",
    "managedBy"
  ],
  "additionalProperties": false
}
